# Copy this file to .env and fill in ONE provider (or none).
# .env is git-ignored, so the key never enters the repo.
# Priority: OpenAI (if OPENAI_API_KEY is set), then Azure, then the rule-based proposer.

# --- OpenAI platform (recommended: cheapest option) ---
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Lowest-cost current text model. Override only if you know you need another.
OPENAI_MODEL=gpt-6-luna

# --- Azure OpenAI (optional) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
